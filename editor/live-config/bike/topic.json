{
  "table": "bike",
  "exclude_condition": {
    "or": [
      { "tag": "highway", "exists": false },
      { "tag": "area", "eq": "yes" },
      { "tag": "access", "eq": "private" },
      { "tag": "bicycle", "eq": "no" },
      { "tag": "service", "eq": "private" },
      { "tag": "highway", "contains": "motor" },
      {
        "tag": "highway",
        "in": [
          "abandoned",
          "bus_guideway",
          "construction",
          "corridor",
          "elevator",
          "escalator",
          "footway",
          "no",
          "planned",
          "platform",
          "proposed",
          "raceway",
          "razed",
          "rest_area",
          "services",
          "steps"
        ]
      }
    ]
  },
  "osm_fields": [
    { "output": "highway", "source": { "key": "highway" } },
    { "output": "name", "source": { "key": "name" } },
    { "output": "ref", "source": { "key": "ref" } },
    { "output": "access", "source": { "key": "access" } },
    { "output": "bicycle", "source": { "key": "bicycle" } },
    { "output": "service", "source": { "key": "service" } },
    { "output": "area", "source": { "key": "area" } },
    { "output": "landuse", "source": { "key": "landuse" } },
    { "output": "bridge", "source": { "key": "bridge" } },
    { "output": "tunnel", "source": { "key": "tunnel" } }
  ],
  "consts": { "minzoom": 0 }
}

