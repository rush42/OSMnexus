{
  "table": "roads",
  "private": {
    "_implicit_oneway_confidence": "not_applicable"
  },
  "transforms": [
    "lifecycle"
  ],
  "exclude_condition": {
    "or": [
      {
        "macro": "standard_exclude"
      },
      {
        "tag": "access",
        "in": [
          "private",
          "no",
          "delivery",
          "permit"
        ]
      },
      {
        "and": [
          {
            "tag": "highway",
            "eq": "footway"
          },
          {
            "tag": "foot",
            "in": [
              "private",
              "no",
              "delivery",
              "permit"
            ]
          }
        ]
      },
      {
        "and": [
          {
            "tag": "highway",
            "eq": "cycleway"
          },
          {
            "tag": "bicycle",
            "in": [
              "private",
              "no",
              "delivery",
              "permit"
            ]
          }
        ]
      },
      {
        "and": [
          {
            "tag": "highway",
            "eq": "service"
          },
          {
            "not": {
              "tag": "bicycle",
              "eq": "designated"
            }
          },
          {
            "not": {
              "first_tag": [
                "bicycle:left",
                "bicycle:right",
                "bicycle:both"
              ],
              "exists": true
            }
          },
          {
            "tag": "service",
            "exists": true
          },
          {
            "not": {
              "tag": "service",
              "eq": "alley"
            }
          }
        ]
      }
    ]
  },
  "osm_fields": [
    {
      "output": "highway",
      "source": {
        "key": "highway"
      }
    },
    {
      "output": "name",
      "source": {
        "key": "name"
      }
    },
    {
      "output": "ref",
      "source": {
        "key": "ref"
      }
    },
    {
      "output": "surface",
      "source": {
        "key": "surface"
      }
    },
    {
      "output": "smoothness",
      "source": {
        "key": "smoothness"
      }
    },
    {
      "output": "maxspeed",
      "source": {
        "key": "maxspeed"
      }
    },
    {
      "output": "oneway",
      "source": {
        "key": "oneway"
      }
    },
    {
      "output": "oneway:bicycle",
      "source": {
        "key": "oneway:bicycle"
      }
    },
    {
      "output": "lit",
      "source": {
        "key": "lit"
      }
    },
    {
      "output": "bridge",
      "source": {
        "key": "bridge"
      }
    },
    {
      "output": "tunnel",
      "source": {
        "key": "tunnel"
      }
    },
    {
      "output": "operator_type",
      "source": {
        "key": "operator_type"
      }
    },
    {
      "output": "informal",
      "source": {
        "key": "informal"
      }
    },
    {
      "output": "covered",
      "source": {
        "key": "covered"
      }
    },
    {
      "output": "traffic_sign",
      "source": {
        "key": "traffic_sign"
      }
    }
  ],
  "sanitizers": [
    {
      "tag": "bridge",
      "name": "yes_flag"
    },
    {
      "tag": "tunnel",
      "name": "yes_flag"
    },
    {
      "tag": "traffic_sign",
      "name": "traffic_sign"
    }
  ],
  "derivers": [
    "lifecycle",
    "road"
  ],
  "minzoom": 0
}
