{
  "table": "bikelanes",
  "exclude_condition": {
    "macro": "standard_exclude"
  },
  "transforms": [
    "lifecycle",
    "cycleway_opposite",
    "construction_prefix",
    "cycleway_both",
    {
      "transform": "split_sides",
      "highway": "cycleway",
      "prefix": "cycleway"
    },
    {
      "transform": "split_sides",
      "highway": "footway",
      "prefix": "sidewalk"
    }
  ],
  "osm_fields": [
    {
      "output": "name",
      "source": {
        "fallback": [
          {
            "key": "name"
          },
          {
            "key": "name",
            "from": "parent"
          }
        ]
      }
    },
    {
      "output": "surface",
      "source": {
        "key": "surface"
      }
    },
    {
      "output": "smoothness",
      "source": {
        "key": "smoothness"
      }
    },
    {
      "output": "width",
      "source": {
        "key": "width"
      }
    },
    {
      "output": "source:width",
      "source": {
        "key": "source:width"
      }
    },
    {
      "output": "bridge",
      "source": {
        "key": "bridge",
        "from": "parent"
      }
    },
    {
      "output": "tunnel",
      "source": {
        "key": "tunnel",
        "from": "parent"
      }
    },
    {
      "output": "oneway",
      "source": {
        "key": "oneway"
      }
    },
    {
      "output": "oneway:bicycle",
      "source": {
        "fallback": [
          {
            "key": "oneway:bicycle"
          },
          {
            "key": "oneway:bicycle",
            "from": "parent"
          }
        ]
      }
    },
    {
      "output": "traffic_sign",
      "source": {
        "key": "traffic_sign"
      }
    },
    {
      "output": "informal",
      "source": {
        "key": "informal",
        "from": "parent"
      }
    },
    {
      "output": "covered",
      "source": {
        "key": "covered",
        "from": "parent"
      }
    },
    {
      "output": "operator_type",
      "source": {
        "key": "operator_type",
        "from": "parent"
      }
    },
    {
      "output": "mapillary",
      "source": {
        "key": "mapillary",
        "from": "parent"
      }
    },
    {
      "output": "segregated",
      "source": {
        "key": "segregated"
      }
    },
    {
      "output": "bicycle",
      "source": {
        "key": "bicycle"
      }
    },
    {
      "output": "foot",
      "source": {
        "key": "foot"
      }
    },
    {
      "output": "description",
      "source": {
        "key": "description"
      }
    },
    {
      "output": "note",
      "source": {
        "key": "note"
      }
    },
    {
      "output": "temporary",
      "source": {
        "key": "temporary"
      }
    },
    {
      "output": "separation:left",
      "source": {
        "key": "separation:left"
      }
    },
    {
      "output": "separation:right",
      "source": {
        "key": "separation:right"
      }
    },
    {
      "output": "separation:both",
      "source": {
        "key": "separation:both"
      }
    },
    {
      "output": "marking:left",
      "source": {
        "key": "marking:left"
      }
    },
    {
      "output": "marking:right",
      "source": {
        "key": "marking:right"
      }
    },
    {
      "output": "marking:both",
      "source": {
        "key": "marking:both"
      }
    },
    {
      "output": "traffic_mode:left",
      "source": {
        "key": "traffic_mode:left"
      }
    },
    {
      "output": "traffic_mode:right",
      "source": {
        "key": "traffic_mode:right"
      }
    },
    {
      "output": "traffic_mode:both",
      "source": {
        "key": "traffic_mode:both"
      }
    },
    {
      "output": "buffer:left",
      "source": {
        "key": "buffer:left"
      }
    },
    {
      "output": "buffer:right",
      "source": {
        "key": "buffer:right"
      }
    },
    {
      "output": "buffer:both",
      "source": {
        "key": "buffer:both"
      }
    },
    {
      "output": "surface:colour",
      "source": {
        "keys": [
          "surface:colour",
          "surface:color"
        ]
      }
    }
  ],
  "sanitized_fields": [
    {
      "output": "traffic_sign",
      "source": {
        "key": "traffic_sign",
        "sanitize": "traffic_sign"
      }
    },
    {
      "output": "separation_left",
      "source": {
        "key": "separation",
        "side": "left",
        "sanitize": "separation"
      }
    },
    {
      "output": "separation_right",
      "source": {
        "key": "separation",
        "side": "right",
        "sanitize": "separation"
      }
    },
    {
      "output": "marking_left",
      "source": {
        "key": "marking",
        "side": "left",
        "sanitize": "marking"
      }
    },
    {
      "output": "marking_right",
      "source": {
        "key": "marking",
        "side": "right",
        "sanitize": "marking"
      }
    },
    {
      "output": "buffer_left",
      "source": {
        "key": "buffer",
        "side": "left",
        "sanitize": "buffer"
      }
    },
    {
      "output": "buffer_right",
      "source": {
        "key": "buffer",
        "side": "right",
        "sanitize": "buffer"
      }
    },
    {
      "output": "surface_color",
      "source": {
        "keys": [
          "surface:colour",
          "surface:color"
        ],
        "sanitize": "surface_color"
      }
    },
    {
      "output": "bridge",
      "source": {
        "key": "bridge",
        "from": "parent_or_obj",
        "sanitize": "yes_flag"
      }
    },
    {
      "output": "tunnel",
      "source": {
        "key": "tunnel",
        "from": "parent_or_obj",
        "sanitize": "yes_flag"
      }
    },
    {
      "output": "oneway",
      "source": {
        "derive": "oneway"
      }
    },
    {
      "output": "width",
      "source": {
        "key": "width",
        "sanitize": "parse_length"
      }
    },
    {
      "output": "width_effective",
      "source": {
        "key": "width:effective",
        "sanitize": "parse_length"
      }
    },
    {
      "output": "lifecycle",
      "source": {
        "fallback": [
          {
            "key": "temporary",
            "sanitize": "temporary"
          },
          {
            "key": "lifecycle"
          },
          {
            "key": "lifecycle",
            "from": "centerline"
          }
        ]
      }
    },
    {
      "output": "surface",
      "source": {
        "fallback": [
          {
            "key": "surface"
          },
          {
            "key": "surface",
            "from": "centerline",
            "if_copy_surface": true
          }
        ]
      }
    },
    {
      "output": "smoothness",
      "source": {
        "fallback": [
          {
            "key": "smoothness"
          },
          {
            "key": "smoothness",
            "from": "centerline",
            "if_copy_surface": true
          }
        ]
      }
    },
    {
      "output_left": "traffic_mode_left",
      "output_right": "traffic_mode_right",
      "derive": "traffic_mode"
    }
  ],
  "minzoom": {
    "default": 0,
    "rules": [
      {
        "when": {
          "length_lt": 100
        },
        "zoom": 9
      }
    ]
  }
}
