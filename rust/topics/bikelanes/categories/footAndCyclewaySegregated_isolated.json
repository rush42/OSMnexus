{
  "infrastructure_exists": true,
  "implicit_oneway_confidence": "low",
  "condition": {
    "and": [
      {
        "macro": "is_foot_and_cycleway_segregated_base"
      },
      {
        "macro": "sidepath_isolated"
      }
    ]
  },
  "excludes": [
    "bicycleRoad",
    "bicycleRoad_vehicleDestination",
    "cyclewayLink",
    "cyclewayOnHighwayBetweenLanes",
    "cyclewayOnHighwayProtected",
    "data_no",
    "footAndCyclewayShared_isolated",
    "not_expected",
    "separate_geometry",
    "sharedBusLaneBikeWithBus",
    "sharedBusLaneBusWithBike",
    "sharedMotorVehicleLane"
  ],
  "consts": {
    "oneway": "implicit_yes"
  }
}
