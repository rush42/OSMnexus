{
  "infrastructure_exists": true,
  "private": {
    "_implicit_oneway_confidence": "low"
  },
  "condition": {
    "and": [
      {
        "tag": "highway",
        "eq": "cycleway"
      },
      {
        "tag": "cycleway",
        "eq": "link"
      }
    ]
  },
  "excludes": [
    "cyclewayOnHighwayProtected",
    "not_expected"
  ],
  "consts": {
    "oneway": "implicit_yes"
  }
}
