{
  "parking_inference": "both",
  "infrastructure_exists": true,
  "private": {
    "_implicit_oneway_confidence": "high"
  },
  "condition": {
    "and": [
      {
        "macro": "is_bicycle_road"
      },
      {
        "or": [
          {
            "tag": "traffic_sign",
            "contains": "1020-30"
          },
          {
            "tag": "traffic_sign",
            "contains": "Kraftfahrzeuge-frei"
          },
          {
            "tag": "traffic_sign",
            "contains": "Kfz-Verkehr frei"
          },
          {
            "tag": "traffic_sign",
            "contains": "KFZ frei"
          },
          {
            "tag": "vehicle",
            "in": [
              "destination",
              "yes"
            ]
          },
          {
            "tag": "motor_vehicle",
            "in": [
              "destination",
              "yes"
            ]
          }
        ]
      }
    ]
  },
  "excludes": [
    "crossing",
    "cyclewayLink",
    "cyclewayOnHighwayProtected",
    "data_no",
    "not_expected",
    "separate_geometry"
  ],
  "derivers": [
    {
      "deriver": "surface_from_parent",
      "output": "surface"
    },
    {
      "deriver": "smoothness_from_parent",
      "output": "smoothness"
    }
  ]
}
