{
  "infrastructure_exists": true,
  "implicit_oneway": false,
  "implicit_oneway_confidence": "high",
  "condition": {
    "and": [
      {
        "tag": "highway",
        "eq": "pedestrian"
      },
      {
        "tag": "bicycle",
        "in": [
          "yes",
          "designated"
        ]
      }
    ]
  },
  "excludes": [
    "bicycleRoad",
    "bicycleRoad_vehicleDestination",
    "crossing",
    "cyclewayOnHighwayProtected",
    "data_no",
    "not_expected",
    "separate_geometry"
  ]
}
