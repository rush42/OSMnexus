{
  "infrastructure_exists": true,
  "implicit_oneway_confidence": "high",
  "condition": {
    "and": [
      {
        "not": {
          "macro": "is_crossing_pattern"
        }
      },
      {
        "tag": "highway",
        "eq": "cycleway"
      },
      {
        "or": [
          {
            "tag": "cycleway",
            "in": [
              "share_busway",
              "opposite_share_busway"
            ]
          },
          {
            "and": [
              {
                "tag": "traffic_sign",
                "starts_with": "DE:245"
              },
              {
                "or": [
                  {
                    "tag": "traffic_sign",
                    "contains": "1022-10"
                  },
                  {
                    "tag": "traffic_sign",
                    "contains": "1022-14"
                  }
                ]
              }
            ]
          },
          {
            "and": [
              {
                "parent_tag": "traffic_sign",
                "starts_with": "DE:245"
              },
              {
                "or": [
                  {
                    "parent_tag": "traffic_sign",
                    "contains": "1022-10"
                  },
                  {
                    "parent_tag": "traffic_sign",
                    "contains": "1022-14"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "excludes": [
    "bicycleRoad",
    "bicycleRoad_vehicleDestination",
    "cyclewayLink",
    "cyclewayOnHighwayProtected",
    "data_no",
    "not_expected",
    "separate_geometry",
    "sharedBusLaneBikeWithBus"
  ],
  "derivers": [
    {
      "deriver": "surface_from_parent",
      "output": "surface"
    },
    {
      "deriver": "smoothness_from_parent",
      "output": "smoothness"
    }
  ],
  "consts": {
    "oneway": "implicit_yes"
  }
}
