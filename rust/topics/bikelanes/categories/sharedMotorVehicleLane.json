{
  "infrastructure_exists": true,
  "private": {
    "_implicit_oneway_confidence": "high"
  },
  "condition": {
    "and": [
      {
        "tag": "highway",
        "eq": "cycleway"
      },
      {
        "tag": "cycleway",
        "eq": "shared_lane"
      }
    ]
  },
  "excludes": [
    "bicycleRoad",
    "bicycleRoad_vehicleDestination",
    "crossing",
    "cyclewayOnHighwayProtected",
    "not_expected",
    "sharedBusLaneBikeWithBus",
    "sharedBusLaneBusWithBike"
  ],
  "derivers": [
    {
      "deriver": "surface_from_parent",
      "output": "surface"
    },
    {
      "deriver": "smoothness_from_parent",
      "output": "smoothness"
    }
  ]
}
