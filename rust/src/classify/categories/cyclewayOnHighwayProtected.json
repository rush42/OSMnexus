{
  "infrastructure_exists": true,
  "implicit_oneway": true,
  "implicit_oneway_confidence": "medium",
  "copy_surface_smoothness_from_parent": true,
  "condition": {
    "and": [
      {
        "not": {
          "macro": "is_crossing_pattern"
        }
      },
      {
        "macro": "is_sidepath"
      },
      {
        "not": {
          "tag": "lane",
          "eq": "advisory"
        }
      },
      {
        "not": {
          "tag": "cycleway",
          "in": [
            "share_busway",
            "opposite_share_busway"
          ]
        }
      },
      {
        "macro": "is_protected_bikelane_separation"
      }
    ]
  },
  "excludes": [
    "data_no",
    "not_expected",
    "separate_geometry"
  ]
}
