              },
              {
                "or": [
                  {
                    "not": {
                      "tag": "foot",
                      "eq": "no"
                    }
                  },
                  {
                    "and": [
                      {
                        "tag": "foot",
                        "eq": "no"
                      },
                      {
                        "not": {
                          "has_key_prefix": "mtb:"
                        }
                      },
                      {
                        "not": {
