{
  "macros": {
    "is_bicycle_road": {
      "or": [
        { "tag": "bicycle_road", "eq": "yes" },
        { "tag": "traffic_sign", "starts_with": "DE:244" }
      ]
    },

    "sidepath_isolated": {
      "or": [
        { "tag": "is_sidepath", "eq": "no" },
        { "tag": "highway", "in": ["service", "track"] }
      ]
    },
    "sidepath_adjoining": {
      "and": [
        { "not": { "macro": "sidepath_isolated" } },
        { "macro": "is_sidepath" }
      ]
    },
    "sidepath_unknown": {
      "and": [
        { "not": { "macro": "sidepath_isolated" } },
        { "not": { "macro": "is_sidepath" } }
      ]
    },

    "is_foot_and_cycleway_shared_base": {
      "and": [
        { "not": { "macro": "is_crossing_pattern" } },
        {
          "or": [
            {
              "and": [
                { "tag": "highway", "eq": "cycleway" },
                { "tag": "cycleway", "eq": "track" },
                { "or": [
                  { "tag": "segregated", "eq": "no" },
                  { "tag": "traffic_sign", "contains": "240" }
                ]}
              ]
            },
            {
              "and": [
                { "tag": "highway", "in": ["cycleway", "path", "footway", "service", "track"] },
                { "or": [
                  {
                    "and": [
                      { "tag": "segregated", "eq": "no" },
                      { "or": [
                        { "and": [{ "tag": "bicycle", "eq": "designated" }, { "tag": "foot", "eq": "designated" }] },
                        { "and": [{ "tag": "bicycle", "eq": "yes"        }, { "tag": "foot", "eq": "yes"        }] }
                      ]}
                    ]
                  },
                  { "tag": "traffic_sign", "contains": "240" }
                ]}
              ]
            }
          ]
        }
      ]
    },

    "is_foot_and_cycleway_segregated_base": {
      "and": [
        { "not": { "macro": "is_crossing_pattern" } },
        {
          "or": [
            {
              "and": [
                { "tag": "highway", "eq": "cycleway" },
                { "tag": "cycleway", "eq": "track" },
                { "or": [
                  { "tag": "segregated", "eq": "yes" },
                  { "tag": "traffic_sign", "contains": "241" }
                ]}
              ]
            },
            {
              "and": [
                { "tag": "highway", "in": ["cycleway", "path", "footway"] },
                { "or": [
                  {
                    "and": [
                      { "tag": "segregated", "eq": "yes" },
                      { "or": [
                        { "and": [{ "tag": "bicycle", "eq": "designated" }, { "tag": "foot", "eq": "designated" }] },
                        { "and": [{ "tag": "bicycle", "eq": "yes"        }, { "tag": "foot", "eq": "yes"        }] }
                      ]}
                    ]
                  },
                  {
                    "and": [
                      { "tag": "traffic_sign", "contains": "241" },
                      { "not": { "tag": "highway", "eq": "footway" } }
                    ]
                  }
                ]}
              ]
            },
            {
              "and": [
                { "tag": "highway", "eq": "cycleway" },
                { "or": [
                  { "tag": "traffic_mode:right", "in": ["foot", "foot;bicycle"] },
                  { "tag": "traffic_mode:both",  "in": ["foot", "foot;bicycle"] }
                ]},
                { "or": [
                  {
                    "and": [
                      { "tag": "separation:right", "exists": false },
                      { "tag": "separation:both",  "exists": false }
                    ]
                  },
                  { "first_tag": ["separation:right", "separation:both"], "in": ["no", "surface", "lane_separator"] }
                ]}
              ]
            }
          ]
        }
      ]
    },

    "is_cycleway_separated_base": {
      "and": [
        { "not": { "tag": "cycleway", "eq": "lane" } },
        { "not": { "macro": "is_crossing_pattern" } },
        {
          "or": [
            {
              "and": [
                { "tag": "highway", "eq": "cycleway" },
                { "tag": "cycleway", "in": ["track", "opposite_track"] }
              ]
            },
            {
              "and": [
                { "tag": "highway", "eq": "cycleway" },
                { "tag": "is_sidepath", "exists": true }
              ]
            },
            {
              "and": [
                { "tag": "highway", "in": ["living_street", "pedestrian", "service", "track", "bridleway", "path", "footway", "cycleway"] },
                { "tag": "traffic_sign", "contains": "237" }
              ]
            }
          ]
        }
      ]
    }
  },

  "categories": [
    {
      "id": "data_no",
      "infrastructure_exists": false,
      "implicit_oneway": false,
      "implicit_oneway_confidence": "not_applicable",
      "copy_surface_smoothness_from_parent": false,
      "condition": { "tag": "cycleway", "in": ["no", "none"] }
    },
    {
      "id": "separate_geometry",
      "infrastructure_exists": false,
      "implicit_oneway": false,
      "implicit_oneway_confidence": "not_applicable",
      "copy_surface_smoothness_from_parent": false,
      "condition": { "tag": "cycleway", "eq": "separate" }
    },
    {
      "id": "not_expected",
      "infrastructure_exists": false,
      "implicit_oneway": false,
      "implicit_oneway_confidence": "not_applicable",
      "copy_surface_smoothness_from_parent": false,
      "condition": {
        "and": [
          { "prefix": "cycleway" },
          { "infix": "" },
          { "side": "left" },
          { "parent_tag": "oneway", "eq": "yes" },
          { "not": { "parent_tag": "oneway:bicycle", "eq": "no" } }
        ]
      }
    },
    {
      "id": "cyclewayOnHighwayProtected",
      "infrastructure_exists": true,
      "implicit_oneway": true,
      "implicit_oneway_confidence": "medium",
      "copy_surface_smoothness_from_parent": true,
      "condition": {
        "and": [
          { "not": { "macro": "is_crossing_pattern" } },
          { "macro": "is_sidepath" },
          { "not": { "tag": "lane", "eq": "advisory" } },
          { "not": { "tag": "cycleway", "in": ["share_busway", "opposite_share_busway"] } },
          {
            "or": [
              {
                "and": [
                  { "first_tag": ["separation:left", "separation:both", "separation"], "in": ["bollard", "flex_post", "vertical_panel", "studs", "bump", "planter", "fence", "jersey_barrier", "guard_rail"] },
                  { "not": { "tag": "segregated", "in": ["yes", "no"] } }
                ]
              },
              {
                "and": [
                  { "tag": "traffic_mode:left", "eq": "parking" },
                  { "tag": "segregated", "exists": false }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cyclewayLink",
      "infrastructure_exists": true,
      "implicit_oneway": true,
      "implicit_oneway_confidence": "low",
      "copy_surface_smoothness_from_parent": false,
      "condition": {
        "and": [
          { "tag": "highway", "eq": "cycleway" },
          { "tag": "cycleway", "eq": "link" }
        ]
      }
    },
    {
      "id": "crossing",
      "infrastructure_exists": true,
      "implicit_oneway": true,
      "implicit_oneway_confidence": "low",
      "copy_surface_smoothness_from_parent": true,
      "condition": {
        "and": [
          { "length_lte": 100.0 },
          { "macro": "is_crossing_pattern" }
        ]
      }
    },
    {
      "id": "bicycleRoad_vehicleDestination",
      "infrastructure_exists": true,
      "implicit_oneway": false,
      "implicit_oneway_confidence": "high",
      "copy_surface_smoothness_from_parent": true,
      "condition": {
        "and": [
          { "macro": "is_bicycle_road" },
          { "or": [
            { "tag": "traffic_sign", "contains": "1020-30" },
            { "tag": "traffic_sign", "contains": "Kraftfahrzeuge-frei" },
            { "tag": "traffic_sign", "contains": "Kfz-Verkehr frei" },
            { "tag": "traffic_sign", "contains": "KFZ frei" },
            { "tag": "vehicle",       "in": ["destination", "yes"] },
            { "tag": "motor_vehicle", "in": ["destination", "yes"] }
          ]}
        ]
      }
    },
    {
      "id": "bicycleRoad",
      "infrastructure_exists": true,
      "implicit_oneway": false,
      "implicit_oneway_confidence": "high",
      "copy_surface_smoothness_from_parent": true,
      "condition": { "macro": "is_bicycle_road" }
    },
    {
      "id": "sharedBusLaneBikeWithBus",
      "infrastructure_exists": true,
      "implicit_oneway": true,
      "implicit_oneway_confidence": "high",
      "copy_surface_smoothness_from_parent": true,
      "condition": {
        "and": [
          { "not": { "macro": "is_crossing_pattern" } },
          { "tag": "highway", "eq": "cycleway" },
          { "or": [
            { "tag": "lane", "eq": "share_busway" },
            { "and": [
              { "tag": "traffic_sign", "starts_with": "DE:237" },
              { "or": [
                { "tag": "traffic_sign", "contains": "1024-14" },
                { "tag": "traffic_sign", "contains": "1026-32" }
              ]}
            ]},
            { "and": [
              { "parent_tag": "traffic_sign", "starts_with": "DE:237" },
              { "or": [
                { "parent_tag": "traffic_sign", "contains": "1024-14" },
                { "parent_tag": "traffic_sign", "contains": "1026-32" }
              ]}
            ]}
          ]}
        ]
      }
    },
    {
      "id": "sharedBusLaneBusWithBike",
      "infrastructure_exists": true,
      "implicit_oneway": true,
      "implicit_oneway_confidence": "high",
      "copy_surface_smoothness_from_parent": true,
      "condition": {
        "and": [
          { "not": { "macro": "is_crossing_pattern" } },
          { "tag": "highway", "eq": "cycleway" },
          { "or": [
            { "tag": "cycleway", "in": ["share_busway", "opposite_share_busway"] },
            { "and": [
              { "tag": "traffic_sign", "starts_with": "DE:245" },
              { "or": [
                { "tag": "traffic_sign", "contains": "1022-10" },
                { "tag": "traffic_sign", "contains": "1022-14" }
              ]}
            ]},
            { "and": [
              { "parent_tag": "traffic_sign", "starts_with": "DE:245" },
              { "or": [
                { "parent_tag": "traffic_sign", "contains": "1022-10" },
                { "parent_tag": "traffic_sign", "contains": "1022-14" }
              ]}
            ]}
          ]}
        ]
      }
    },
    {
      "id": "pedestrianAreaBicycleYes",
      "infrastructure_exists": true,
      "implicit_oneway": false,
      "implicit_oneway_confidence": "high",
      "copy_surface_smoothness_from_parent": false,
      "condition": {
        "and": [
          { "tag": "highway",  "eq": "pedestrian" },
          { "tag": "bicycle", "in": ["yes", "designated"] }
        ]
      }
    },
    {
      "id": "sharedMotorVehicleLane",
      "infrastructure_exists": true,
      "implicit_oneway": false,
      "implicit_oneway_confidence": "high",
      "copy_surface_smoothness_from_parent": true,
      "condition": {
        "and": [
          { "tag": "highway",  "eq": "cycleway"     },
          { "tag": "cycleway", "eq": "shared_lane"  }
        ]
      }
    },
    {
      "id": "cyclewayOnHighwayBetweenLanes",
      "infrastructure_exists": true,
      "implicit_oneway": true,
      "implicit_oneway_confidence": "high",
      "copy_surface_smoothness_from_parent": true,
      "condition": {
        "and": [
          { "side": "self" },
          { "or": [
            { "tag": "cycleway:lanes", "contains": "|lane|"       },
            { "tag": "bicycle:lanes",  "contains": "|designated|" }
          ]}
        ]
      }
    },

    {
      "id": "footAndCyclewayShared_adjoining",
      "infrastructure_exists": true,
      "implicit_oneway": true,
      "implicit_oneway_confidence": "low",
      "copy_surface_smoothness_from_parent": false,
      "condition": { "and": [{ "macro": "is_foot_and_cycleway_shared_base" }, { "macro": "sidepath_adjoining" }] }
    },
    {
      "id": "footAndCyclewayShared_isolated",
      "infrastructure_exists": true,
      "implicit_oneway": true,
      "implicit_oneway_confidence": "low",
      "copy_surface_smoothness_from_parent": false,
      "condition": { "and": [{ "macro": "is_foot_and_cycleway_shared_base" }, { "macro": "sidepath_isolated" }] }
    },
    {
      "id": "footAndCyclewayShared_adjoiningOrIsolated",
      "infrastructure_exists": true,
      "implicit_oneway": true,
      "implicit_oneway_confidence": "low",
      "copy_surface_smoothness_from_parent": false,
      "condition": { "and": [{ "macro": "is_foot_and_cycleway_shared_base" }, { "macro": "sidepath_unknown" }] }
    },

    {
      "id": "footAndCyclewaySegregated_adjoining",
      "infrastructure_exists": true,
      "implicit_oneway": true,
      "implicit_oneway_confidence": "low",
      "copy_surface_smoothness_from_parent": false,
      "condition": { "and": [{ "macro": "is_foot_and_cycleway_segregated_base" }, { "macro": "sidepath_adjoining" }] }
    },
    {
      "id": "footAndCyclewaySegregated_isolated",
      "infrastructure_exists": true,
      "implicit_oneway": true,
      "implicit_oneway_confidence": "low",
      "copy_surface_smoothness_from_parent": false,
      "condition": { "and": [{ "macro": "is_foot_and_cycleway_segregated_base" }, { "macro": "sidepath_isolated" }] }
    },
    {
      "id": "footAndCyclewaySegregated_adjoiningOrIsolated",
      "infrastructure_exists": true,
      "implicit_oneway": true,
      "implicit_oneway_confidence": "low",
      "copy_surface_smoothness_from_parent": false,
      "condition": { "and": [{ "macro": "is_foot_and_cycleway_segregated_base" }, { "macro": "sidepath_unknown" }] }
    },

    {
      "id": "cyclewaySeparated_adjoining",
      "infrastructure_exists": true,
      "implicit_oneway": false,
      "implicit_oneway_confidence": "low",
      "copy_surface_smoothness_from_parent": false,
      "condition": { "and": [{ "macro": "is_cycleway_separated_base" }, { "macro": "sidepath_adjoining" }] }
    },
    {
      "id": "cyclewaySeparated_isolated",
      "infrastructure_exists": true,
      "implicit_oneway": false,
      "implicit_oneway_confidence": "low",
      "copy_surface_smoothness_from_parent": false,
      "condition": { "and": [{ "macro": "is_cycleway_separated_base" }, { "macro": "sidepath_isolated" }] }
    },
    {
      "id": "cyclewaySeparated_adjoiningOrIsolated",
      "infrastructure_exists": true,
      "implicit_oneway": false,
      "implicit_oneway_confidence": "low",
      "copy_surface_smoothness_from_parent": false,
      "condition": { "and": [{ "macro": "is_cycleway_separated_base" }, { "macro": "sidepath_unknown" }] }
    },

    {
      "id": "cyclewayOnHighway_advisory",
      "infrastructure_exists": true,
      "implicit_oneway": true,
      "implicit_oneway_confidence": "high",
      "copy_surface_smoothness_from_parent": true,
      "condition": { "and": [{ "macro": "is_advisory_or_exclusive" }, { "tag": "lane", "eq": "advisory" }] }
    },
    {
      "id": "cyclewayOnHighway_exclusive",
      "infrastructure_exists": true,
      "implicit_oneway": true,
      "implicit_oneway_confidence": "high",
      "copy_surface_smoothness_from_parent": true,
      "condition": { "and": [{ "macro": "is_advisory_or_exclusive" }, { "tag": "lane", "eq": "exclusive" }] }
    },
    {
      "id": "cyclewayOnHighway_advisoryOrExclusive",
      "infrastructure_exists": true,
      "implicit_oneway": true,
      "implicit_oneway_confidence": "medium",
      "copy_surface_smoothness_from_parent": true,
      "condition": { "macro": "is_advisory_or_exclusive" }
    },

    {
      "id": "footwayBicycleYes_adjoining",
      "infrastructure_exists": true,
      "implicit_oneway": true,
      "implicit_oneway_confidence": "low",
      "copy_surface_smoothness_from_parent": false,
      "condition": { "and": [{ "macro": "is_footway_bicycle_yes_base" }, { "macro": "sidepath_adjoining" }] }
    },
    {
      "id": "footwayBicycleYes_isolated",
      "infrastructure_exists": true,
      "implicit_oneway": true,
      "implicit_oneway_confidence": "low",
      "copy_surface_smoothness_from_parent": false,
      "condition": { "and": [{ "macro": "is_footway_bicycle_yes_base" }, { "macro": "sidepath_isolated" }] }
    },
    {
      "id": "footwayBicycleYes_adjoiningOrIsolated",
      "infrastructure_exists": true,
      "implicit_oneway": true,
      "implicit_oneway_confidence": "low",
      "copy_surface_smoothness_from_parent": false,
      "condition": { "and": [{ "macro": "is_footway_bicycle_yes_base" }, { "macro": "sidepath_unknown" }] }
    },

    {
      "id": "needsClarification",
      "infrastructure_exists": true,
      "implicit_oneway": false,
      "implicit_oneway_confidence": "low",
      "copy_surface_smoothness_from_parent": false,
      "condition": {
        "and": [
          { "not": { "macro": "has_between_lanes_conditions" } },
          { "not": { "tag": "cycleway", "eq": "shared" } },
          { "or": [
            { "tag": "highway", "eq": "cycleway" },
            {
              "and": [
                { "tag": "highway",  "eq": "path"       },
                { "tag": "bicycle", "eq": "designated"  },
                { "or": [
                  { "not": { "tag": "foot", "eq": "no" } },
                  {
                    "and": [
                      { "tag": "foot", "eq": "no" },
                      { "not": { "has_key_prefix": "mtb:" } },
                      { "not": { "tag": "mtb", "eq": "yes" } },
                      { "not": { "tag": "surface", "in": ["ground", "dirt", "fine_gravel", "gravel", "pebblestone", "earth"] } }
                    ]
                  }
                ]}
              ]
            },
            {
              "and": [
                { "tag": "highway",  "eq": "footway"    },
                { "tag": "bicycle", "eq": "designated"  }
              ]
            }
          ]}
        ]
      }
    }
  ]
}
