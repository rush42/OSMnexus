{
  "road": {
    "match": [
      { "when": { "key": "bicycle_road", "eq": "yes" }, "value": "bicycle_road" },
      { "match": [
        { "when": { "and": [ { "key": "highway", "eq": "service" }, { "key": "service", "eq": "driveway" }, { "key": "emergency", "in": ["yes", "designated"] } ] }, "value": "service_emergency_access" },
        { "when": { "and": [ { "key": "highway", "eq": "service" }, { "key": "service", "eq": "alley" } ] }, "value": "service_alley" },
        { "when": { "and": [ { "key": "highway", "eq": "service" }, { "key": "service", "eq": "driveway" } ] }, "value": "service_driveway" },
        { "when": { "and": [ { "key": "highway", "eq": "service" }, { "key": "service", "eq": "emergency_access" } ] }, "value": "service_emergency_access" },
        { "when": { "and": [ { "key": "highway", "eq": "service" }, { "key": "service", "eq": "parking_isle" } ] }, "value": "service_parking_aisle" },
        { "when": { "and": [ { "key": "highway", "eq": "service" }, { "key": "service", "exists": false } ] }, "value": "service_road" },
        { "when": { "key": "highway", "eq": "service" }, "value": "service_uncategorized" },

        { "when": { "and": [ { "key": "highway", "eq": "residential" }, { "key": "priority_road", "in": ["designated", "yes_unposted"] } ] }, "value": "residential_priority_road" },

        { "when": { "and": [ { "key": "highway", "eq": "path" }, { "key": "path", "in": ["crossing", "traffic_island"] } ] }, "value": "footway_cycleway_crossing" },
        { "when": { "and": [ { "key": "highway", "eq": "cycleway" }, { "key": "cycleway", "in": ["crossing", "traffic_island"] } ] }, "value": "cycleway_crossing" },
        { "when": { "and": [ { "key": "highway", "eq": "footway" }, { "key": "footway", "in": ["crossing", "traffic_island"] } ] }, "value": "footway_crossing" },

        { "when": { "or": [
            { "and": [ { "key": "highway", "eq": "footway" }, { "key": "footway", "eq": "sidewalk" } ] },
            { "and": [ { "key": "highway", "eq": "path" }, { "key": "is_sidepath", "eq": "yes" } ] },
            { "and": [ { "key": "highway", "eq": "path" }, { "key": "path", "in": ["sidewalk", "sidepath"] } ] }
          ] }, "value": "footway_sidewalk" },

        { "when": { "key": "highway", "eq": "road" }, "value": "unspecified_road" },
        { "when": { "key": "highway", "eq": "steps" }, "value": "footway_steps" },
        { "when": { "key": "highway", "exists": true }, "value": { "key": "highway" } }
      ] }
    ]
  }
}
