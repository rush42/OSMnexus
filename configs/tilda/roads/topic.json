{
  "table": "roads",
  "geometry": {
    "way": ["line"]
  },
  "passthrough_tags": [
    "highway",
    "name",
    "ref",
    "surface",
    "smoothness",
    "maxspeed",
    "oneway",
    "oneway:bicycle",
    "lit",
    "operator_type",
    "informal",
    "covered"
  ],
  "producers": {
    "bridge": {
      "sanitizer": "to_bool"
    },
    "tunnel": {
      "sanitizer": "to_bool"
    },
    "traffic_sign": {
      "sanitizer": "traffic_sign"
    },
    "lifecycle": "lifecycle",
    "road": "road"
  },
  "exclude_condition": {
    "or": [
      {
        "macro": "standard_exclude"
      },
      {
        "and": [
          {
            "tag": "access",
            "in": [
              "private",
              "no",
              "delivery",
              "permit"
            ]
          },
          { "not": { "macro": "is_construction_or_blocked_raw" } }
        ]
      },
      {
        "and": [
          {
            "macro": "effective_highway_eq_footway"
          },
          {
            "tag": "foot",
            "in": [
              "private",
              "no",
              "delivery",
              "permit"
            ]
          },
          { "not": { "macro": "is_construction_or_blocked_raw" } }
        ]
      },
      {
        "and": [
          {
            "macro": "effective_highway_eq_cycleway"
          },
          {
            "tag": "bicycle",
            "in": [
              "private",
              "no",
              "delivery",
              "permit"
            ]
          },
          { "not": { "macro": "is_construction_or_blocked_raw" } }
        ]
      },
      {
        "and": [
          {
            "macro": "effective_highway_eq_service"
          },
          {
            "not": {
              "tag": "bicycle",
              "eq": "designated"
            }
          },
          {
            "not": {
              "first_tag": [
                "bicycle:left",
                "bicycle:right",
                "bicycle:both"
              ],
              "exists": true
            }
          },
          {
            "tag": "service",
            "exists": true
          },
          {
            "not": {
              "tag": "service",
              "eq": "alley"
            }
          }
        ]
      }
    ]
  },
  "defaults": {
    "minzoom": 0
  }
}
