{
  "table": "roads",
  "outputs": {
    "highway": true,
    "name": true,
    "ref": true,
    "surface": true,
    "smoothness": true,
    "maxspeed": true,
    "oneway": true,
    "oneway:bicycle": true,
    "lit": true,
    "bridge": {
      "name": "yes_flag"
    },
    "tunnel": {
      "name": "yes_flag"
    },
    "operator_type": true,
    "informal": true,
    "covered": true,
    "traffic_sign": {
      "name": "traffic_sign"
    },
    "lifecycle": "lifecycle",
    "road": "road"
  },
  "exclude_condition": {
    "or": [
      {
        "macro": "standard_exclude"
      },
      {
        "tag": "access",
        "in": [
          "private",
          "no",
          "delivery",
          "permit"
        ]
      },
      {
        "and": [
          {
            "tag": "highway",
            "eq": "footway"
          },
          {
            "tag": "foot",
            "in": [
              "private",
              "no",
              "delivery",
              "permit"
            ]
          }
        ]
      },
      {
        "and": [
          {
            "tag": "highway",
            "eq": "cycleway"
          },
          {
            "tag": "bicycle",
            "in": [
              "private",
              "no",
              "delivery",
              "permit"
            ]
          }
        ]
      },
      {
        "and": [
          {
            "tag": "highway",
            "eq": "service"
          },
          {
            "not": {
              "tag": "bicycle",
              "eq": "designated"
            }
          },
          {
            "not": {
              "first_tag": [
                "bicycle:left",
                "bicycle:right",
                "bicycle:both"
              ],
              "exists": true
            }
          },
          {
            "tag": "service",
            "exists": true
          },
          {
            "not": {
              "tag": "service",
              "eq": "alley"
            }
          }
        ]
      }
    ]
  },
  "defaults": {
    "minzoom": 0
  }
}
