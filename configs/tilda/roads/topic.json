{
  "table": "roads",
  "private": {
    "_implicit_oneway_confidence": "not_applicable"
  },
  "transforms": [
    "lifecycle",
    {
      "transform": "unnest_sidepath_self",
      "prefix": "cycleway"
    },
    {
      "transform": "tag_rules",
      "output": "traffic_sign",
      "rules": [
        {
          "when": {
            "and": [
              {
                "tag": "highway",
                "in_set": "sidepath_highway"
              },
              {
                "tag": "traffic_sign",
                "exists": false
              },
              {
                "tag": "oneway",
                "eq": "yes"
              },
              {
                "not": {
                  "tag": "oneway:bicycle",
                  "eq": "no"
                }
              }
            ]
          },
          "value": {
            "tag_or": "traffic_sign:forward",
            "or": ""
          }
        }
      ]
    }
  ],
  "exclude_condition": {
    "or": [
      {
        "macro": "standard_exclude"
      },
      {
        "tag": "access",
        "in": [
          "private",
          "no",
          "delivery",
          "permit"
        ]
      },
      {
        "and": [
          {
            "tag": "highway",
            "eq": "footway"
          },
          {
            "tag": "foot",
            "in": [
              "private",
              "no",
              "delivery",
              "permit"
            ]
          }
        ]
      },
      {
        "and": [
          {
            "tag": "highway",
            "eq": "cycleway"
          },
          {
            "tag": "bicycle",
            "in": [
              "private",
              "no",
              "delivery",
              "permit"
            ]
          }
        ]
      },
      {
        "and": [
          {
            "tag": "highway",
            "eq": "service"
          },
          {
            "not": {
              "tag": "bicycle",
              "eq": "designated"
            }
          },
          {
            "not": {
              "first_tag": [
                "bicycle:left",
                "bicycle:right",
                "bicycle:both"
              ],
              "exists": true
            }
          },
          {
            "tag": "service",
            "exists": true
          },
          {
            "not": {
              "tag": "service",
              "eq": "alley"
            }
          }
        ]
      }
    ]
  },
  "osm_fields": [
    "highway",
    "name",
    "ref",
    "surface",
    "smoothness",
    "maxspeed",
    "oneway",
    "oneway:bicycle",
    "lit",
    "bridge",
    "tunnel",
    "operator_type",
    "informal",
    "covered",
    "traffic_sign"
  ],
  "sanitizers": [
    {
      "tag": "bridge",
      "name": "yes_flag"
    },
    {
      "tag": "tunnel",
      "name": "yes_flag"
    },
    {
      "tag": "traffic_sign",
      "name": "traffic_sign"
    }
  ],
  "derivers": [
    "lifecycle",
    "road"
  ],
  "consts": {
    "minzoom": 0
  }
}
