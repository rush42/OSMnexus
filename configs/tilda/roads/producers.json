{
  "lifecycle": {
    "fallback": [
      { "key": "temporary", "sanitize": "temporary" },
      { "key": "lifecycle" },
      { "parent": { "key": "lifecycle" } }
    ]
  },
  "road": { "parent_or_obj": { "shared": "road" } },
  "track_minzoom": {
    "default": 0,
    "rules": [
      {
        "when": { "not": { "tag": "tracktype", "in": ["grade1", "grade2"] } },
        "value": 11
      }
    ]
  }
}
