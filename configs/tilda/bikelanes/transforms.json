{
  "way": [
    { "annotate": { "_side": "self" } },
    {
      "output": "highway",
      "match": [
        {
          "when": {
            "and": [
              { "key": "highway", "exists": true },
              { "key": "construction", "in": "allowed_highway" }
            ]
          },
          "value": { "key": "construction" }
        }
      ]
    },
    {
      "output": "lifecycle",
      "match": [
        {
          "when": {
            "and": [
              { "key": "highway", "exists": true },
              { "key": "construction", "in": "allowed_highway" }
            ]
          },
          "value": "construction"
        },
        {
          "when": {
            "and": [
              {
                "or": [
                  { "key": "access", "eq": "no" },
                  { "and": [ { "key": "highway", "eq": "cycleway" }, { "key": "bicycle", "eq": "no" } ] },
                  { "and": [ { "key": "highway", "eq": "footway" }, { "key": "foot", "eq": "no" } ] }
                ]
              },
              {
                "or": [
                  { "key": "access:reason", "contains": "construction", "case_insensitive": true },
                  { "key": "access:reason", "contains": "baustelle", "case_insensitive": true },
                  { "key": "description", "contains": "construction", "case_insensitive": true },
                  { "key": "description", "contains": "baustelle", "case_insensitive": true },
                  { "key": "note", "contains": "construction", "case_insensitive": true },
                  { "key": "note", "contains": "baustelle", "case_insensitive": true }
                ]
              }
            ]
          },
          "value": "construction_no_access"
        },
        {
          "when": {
            "and": [
              {
                "or": [
                  { "key": "access", "eq": "no" },
                  { "and": [ { "key": "highway", "eq": "cycleway" }, { "key": "bicycle", "eq": "no" } ] },
                  { "and": [ { "key": "highway", "eq": "footway" }, { "key": "foot", "eq": "no" } ] }
                ]
              },
              {
                "or": [
                  { "key": "description", "contains": "sperrung", "case_insensitive": true },
                  { "key": "description", "contains": "gesperrt", "case_insensitive": true },
                  { "key": "description", "contains": "blockiert", "case_insensitive": true },
                  { "key": "description", "contains": "blocked", "case_insensitive": true },
                  { "key": "description", "contains": "closure", "case_insensitive": true },
                  { "key": "description", "contains": "closed", "case_insensitive": true },
                  { "key": "note", "contains": "sperrung", "case_insensitive": true },
                  { "key": "note", "contains": "gesperrt", "case_insensitive": true },
                  { "key": "note", "contains": "blockiert", "case_insensitive": true },
                  { "key": "note", "contains": "blocked", "case_insensitive": true },
                  { "key": "note", "contains": "closure", "case_insensitive": true },
                  { "key": "note", "contains": "closed", "case_insensitive": true }
                ]
              }
            ]
          },
          "value": "blocked"
        }
      ]
    },
    {
      "output": "construction",
      "match": [
        { "when": { "key": "lifecycle", "eq": "construction" }, "value": null }
      ]
    },
    {
      "output": "access",
      "match": [
        { "when": { "key": "lifecycle", "in": ["construction_no_access", "blocked"] }, "value": null }
      ]
    },
    {
      "output": "bicycle",
      "match": [
        {
          "when": {
            "and": [
              { "key": "lifecycle", "in": ["construction_no_access", "blocked"] },
              { "key": "highway", "eq": "cycleway" }
            ]
          },
          "value": null
        }
      ]
    },
    {
      "output": "foot",
      "match": [
        {
          "when": {
            "and": [
              { "key": "lifecycle", "in": ["construction_no_access", "blocked"] },
              { "key": "highway", "eq": "footway" }
            ]
          },
          "value": null
        }
      ]
    },
    {
      "output": "oneway:bicycle",
      "match": [
        { "when": { "key": "cycleway", "in": ["opposite", "opposite_lane", "opposite_track"] }, "value": "no" }
      ]
    },
    {
      "output": "cycleway:left",
      "match": [
        { "when": { "key": "cycleway", "eq": "opposite_lane" }, "value": "lane" },
        { "when": { "key": "cycleway", "eq": "opposite_track" }, "value": "track" }
      ]
    },
    {
      "output": "cycleway",
      "match": [
        { "when": { "key": "cycleway", "in": ["opposite", "opposite_lane", "opposite_track"] }, "value": null }
      ]
    },
    {
      "prefix": "construction:",
      "stamp_key": "lifecycle",
      "stamp_value": "construction",
      "stamp_nested_under": ["cycleway:", "sidewalk:"]
    },
    {
      "output": "cycleway:both",
      "match": [
        { "when": { "key": "cycleway", "eq": "no" }, "value": { "key": "cycleway" } }
      ]
    },
    {
      "output": "cycleway",
      "match": [
        { "when": { "key": "cycleway", "eq": "no" }, "value": null }
      ]
    },
    {
      "unnest": "cycleway",
      "meta": ["source:", "note:"],
      "guard": { "key": "highway", "in": "sidepath_highway" }
    },
    {
      "output": "traffic_sign",
      "match": [
        {
          "when": {
            "and": [
              { "key": "highway", "in": "sidepath_highway" },
              { "key": "traffic_sign", "exists": false },
              { "key": "oneway", "eq": "yes" },
              { "not": { "key": "oneway:bicycle", "eq": "no" } }
            ]
          },
          "value": { "key": "traffic_sign:forward", "or": "" }
        }
      ]
    },
    {
      "clone": {
        "when": { "not": { "key": "highway", "eq": "cycleway" } },
        "annotate": { "_side": "left", "_prefix": "cycleway" },
        "id_suffix": "cycleway/left",
        "steps": [
          { "unnest": "cycleway", "infix": "", "meta": ["source:", "note:"], "record_infix_as": "_infix" },
          { "unnest": "cycleway", "infix": "both", "meta": ["source:", "note:"], "record_infix_as": "_infix" },
          { "unnest": "cycleway", "infix": "left", "meta": ["source:", "note:"], "record_infix_as": "_infix" },
          { "drop": { "tags_empty": true } },
          {
            "drop": {
              "and": [
                { "key": "_infix", "eq": "" },
                { "parent": { "key": "oneway", "eq": "yes" } },
                { "not": { "parent": { "key": "oneway:bicycle", "eq": "no" } } }
              ]
            }
          },
          { "output": "highway", "match": [], "default": "cycleway" },
          { "output": "cycleway:lanes", "directed": { "side": "left", "key": "cycleway:lanes", "from": "parent" } },
          { "output": "bicycle:lanes", "directed": { "side": "left", "key": "bicycle:lanes", "from": "parent" } },
          { "output": "traffic_sign", "directed": { "side": "left", "key": "traffic_sign", "from": "obj" } }
        ]
      }
    },
    {
      "clone": {
        "when": { "not": { "key": "highway", "eq": "cycleway" } },
        "annotate": { "_side": "right", "_prefix": "cycleway" },
        "id_suffix": "cycleway/right",
        "steps": [
          { "unnest": "cycleway", "infix": "", "meta": ["source:", "note:"], "record_infix_as": "_infix" },
          { "unnest": "cycleway", "infix": "both", "meta": ["source:", "note:"], "record_infix_as": "_infix" },
          { "unnest": "cycleway", "infix": "right", "meta": ["source:", "note:"], "record_infix_as": "_infix" },
          { "drop": { "tags_empty": true } },
          { "output": "highway", "match": [], "default": "cycleway" },
          { "output": "cycleway:lanes", "directed": { "side": "right", "key": "cycleway:lanes", "from": "parent" } },
          { "output": "bicycle:lanes", "directed": { "side": "right", "key": "bicycle:lanes", "from": "parent" } },
          { "output": "traffic_sign", "directed": { "side": "right", "key": "traffic_sign", "from": "obj" } }
        ]
      }
    },
    {
      "clone": {
        "when": { "not": { "key": "highway", "eq": "footway" } },
        "annotate": { "_side": "left", "_prefix": "sidewalk" },
        "id_suffix": "sidewalk/left",
        "steps": [
          { "unnest": "sidewalk", "infix": "", "meta": ["source:", "note:"], "record_infix_as": "_infix" },
          { "unnest": "sidewalk", "infix": "both", "meta": ["source:", "note:"], "record_infix_as": "_infix" },
          { "unnest": "sidewalk", "infix": "left", "meta": ["source:", "note:"], "record_infix_as": "_infix" },
          { "drop": { "tags_empty": true } },
          { "output": "highway", "match": [], "default": "footway" },
          { "output": "traffic_sign", "directed": { "side": "left", "key": "traffic_sign", "from": "obj" } }
        ]
      }
    },
    {
      "clone": {
        "when": { "not": { "key": "highway", "eq": "footway" } },
        "annotate": { "_side": "right", "_prefix": "sidewalk" },
        "id_suffix": "sidewalk/right",
        "steps": [
          { "unnest": "sidewalk", "infix": "", "meta": ["source:", "note:"], "record_infix_as": "_infix" },
          { "unnest": "sidewalk", "infix": "both", "meta": ["source:", "note:"], "record_infix_as": "_infix" },
          { "unnest": "sidewalk", "infix": "right", "meta": ["source:", "note:"], "record_infix_as": "_infix" },
          { "drop": { "tags_empty": true } },
          { "output": "highway", "match": [], "default": "footway" },
          { "output": "traffic_sign", "directed": { "side": "right", "key": "traffic_sign", "from": "obj" } }
        ]
      }
    }
  ]
}
