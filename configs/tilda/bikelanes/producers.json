{
  "oneway": {
    "rules": [
      { "when": { "tag": "oneway:bicycle", "eq": "yes" }, "value": "yes" },
      { "when": { "and": [ { "tag": "oneway:bicycle", "eq": "no" }, { "tag": "oneway", "eq": "yes" } ] }, "value": "car_not_bike" },
      { "when": { "tag": "oneway:bicycle", "eq": "no" }, "value": "no" },
      { "when": { "tag": "oneway", "in": ["yes", "no"] }, "value": { "tag": "oneway" } },
      { "when": { "tag": "highway", "in": ["service", "track"] }, "value": "assumed_no" }
    ]
  },
  "road": { "parent_or_obj": { "shared": "road" } },
  "traffic_mode_left": {
    "rules": [
      { "when": { "or": [
          { "first_tag": ["traffic_mode:left", "traffic_mode:both", "traffic_mode"], "sanitize": "traffic_mode", "exists": true },
          { "first_tag": ["traffic_mode:right", "traffic_mode:both"], "sanitize": "traffic_mode", "exists": true }
        ] },
        "value": { "keys": ["traffic_mode:left", "traffic_mode:both", "traffic_mode"], "sanitize": "traffic_mode" } }
    ]
  },
  "traffic_mode_right": {
    "rules": [
      { "when": { "or": [
          { "first_tag": ["traffic_mode:left", "traffic_mode:both", "traffic_mode"], "sanitize": "traffic_mode", "exists": true },
          { "first_tag": ["traffic_mode:right", "traffic_mode:both"], "sanitize": "traffic_mode", "exists": true }
        ] },
        "value": { "keys": ["traffic_mode:right", "traffic_mode:both"], "sanitize": "traffic_mode" } }
    ]
  },
  "traffic_mode_left_from_parking_both": {
    "rules": [
      { "when": { "or": [
          { "first_tag": ["traffic_mode:left", "traffic_mode:both", "traffic_mode"], "sanitize": "traffic_mode", "exists": true },
          { "first_tag": ["traffic_mode:right", "traffic_mode:both"], "sanitize": "traffic_mode", "exists": true }
        ] },
        "value": { "keys": ["traffic_mode:left", "traffic_mode:both", "traffic_mode"], "sanitize": "traffic_mode" } },
      { "when": true, "value": { "parent_or_obj": { "keys": ["parking:left", "parking:both"], "sanitize": "parking" } } }
    ]
  },
  "traffic_mode_right_from_parking_both": {
    "rules": [
      { "when": { "or": [
          { "first_tag": ["traffic_mode:left", "traffic_mode:both", "traffic_mode"], "sanitize": "traffic_mode", "exists": true },
          { "first_tag": ["traffic_mode:right", "traffic_mode:both"], "sanitize": "traffic_mode", "exists": true }
        ] },
        "value": { "keys": ["traffic_mode:right", "traffic_mode:both"], "sanitize": "traffic_mode" } },
      { "when": true, "value": { "parent_or_obj": { "keys": ["parking:right", "parking:both"], "sanitize": "parking" } } }
    ]
  },
  "traffic_mode_left_from_parking_directional": {
    "rules": [
      { "when": { "or": [
          { "first_tag": ["traffic_mode:left", "traffic_mode:both", "traffic_mode"], "sanitize": "traffic_mode", "exists": true },
          { "first_tag": ["traffic_mode:right", "traffic_mode:both"], "sanitize": "traffic_mode", "exists": true }
        ] },
        "value": { "keys": ["traffic_mode:left", "traffic_mode:both", "traffic_mode"], "sanitize": "traffic_mode" } },
      { "when": { "side": "left" },
        "value": { "parent_or_obj": { "keys": ["parking:left", "parking:both"], "sanitize": "parking" } } }
    ]
  },
  "traffic_mode_right_from_parking_directional": {
    "rules": [
      { "when": { "or": [
          { "first_tag": ["traffic_mode:left", "traffic_mode:both", "traffic_mode"], "sanitize": "traffic_mode", "exists": true },
          { "first_tag": ["traffic_mode:right", "traffic_mode:both"], "sanitize": "traffic_mode", "exists": true }
        ] },
        "value": { "keys": ["traffic_mode:right", "traffic_mode:both"], "sanitize": "traffic_mode" } },
      { "when": { "side": "right" },
        "value": { "parent_or_obj": { "keys": ["parking:right", "parking:both"], "sanitize": "parking" } } }
    ]
  },
  "lifecycle": {
    "fallback": [
      { "key": "temporary", "sanitize": "temporary" },
      { "key": "lifecycle" },
      { "parent": { "key": "lifecycle" } }
    ]
  },
  "surface": {
    "fallback": [
      { "rules": [
          { "when": { "and": [ { "tag": "surface", "eq": "sett" }, { "num": "sett:length", "sanitize": "parse_length", "lte": 0.08 } ] }, "value": "mosaic_sett" },
          { "when": { "and": [ { "tag": "surface", "eq": "sett" }, { "num": "sett:length", "sanitize": "parse_length", "lte": 0.13 } ] }, "value": "small_sett" },
          { "when": { "and": [ { "tag": "surface", "eq": "sett" }, { "num": "sett:length", "sanitize": "parse_length", "gt": 0.13 } ] }, "value": "large_sett" }
        ], "annotate": { "source": "tag", "confidence": "high" } },
      { "key": "surface", "sanitize": "surface_normalize", "annotate": { "source": "tag", "confidence": "high" } }
    ]
  },
  "surface_from_parent": {
    "fallback": [
      { "rules": [
          { "when": { "and": [ { "tag": "surface", "eq": "sett" }, { "num": "sett:length", "sanitize": "parse_length", "lte": 0.08 } ] }, "value": "mosaic_sett" },
          { "when": { "and": [ { "tag": "surface", "eq": "sett" }, { "num": "sett:length", "sanitize": "parse_length", "lte": 0.13 } ] }, "value": "small_sett" },
          { "when": { "and": [ { "tag": "surface", "eq": "sett" }, { "num": "sett:length", "sanitize": "parse_length", "gt": 0.13 } ] }, "value": "large_sett" }
        ], "annotate": { "source": "tag", "confidence": "high" } },
      { "key": "surface", "sanitize": "surface_normalize", "annotate": { "source": "tag", "confidence": "high" } },
      { "parent": { "rules": [
          { "when": { "and": [ { "tag": "surface", "eq": "sett" }, { "num": "sett:length", "sanitize": "parse_length", "lte": 0.08 } ] }, "value": "mosaic_sett" },
          { "when": { "and": [ { "tag": "surface", "eq": "sett" }, { "num": "sett:length", "sanitize": "parse_length", "lte": 0.13 } ] }, "value": "small_sett" },
          { "when": { "and": [ { "tag": "surface", "eq": "sett" }, { "num": "sett:length", "sanitize": "parse_length", "gt": 0.13 } ] }, "value": "large_sett" }
        ], "annotate": { "source": "parent_highway_tag", "confidence": "high" } } },
      { "parent": { "key": "surface", "sanitize": "surface_normalize", "annotate": { "source": "parent_highway_tag", "confidence": "high" } } }
    ]
  },
  "smoothness": {
    "fallback": [
      { "key": "smoothness", "sanitize": "smoothness_direct", "annotate": { "source": "tag",            "confidence": "high" } },
      { "key": "smoothness", "sanitize": "smoothness_norm",   "annotate": { "source": "tag_normalized", "confidence": "high" } },
      { "key": "surface",    "sanitize": "surface_to_smoothness",   "annotate": { "source": "surface_to_smoothness",   "confidence": "medium" } },
      { "key": "tracktype",  "sanitize": "tracktype_to_smoothness", "annotate": { "source": "tracktype_to_smoothness", "confidence": "medium" } },
      { "key": "mtb:scale",  "sanitize": "mtb_scale_to_smoothness", "annotate": { "source": "mtb:scale_to_smoothness", "confidence": "medium" } }
    ]
  }
}
