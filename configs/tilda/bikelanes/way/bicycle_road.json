{
  "condition": {
    "macro": "is_bicycle_road"
  },
  "excludes": [
    "bicycle_road_vehicle_destination",
    "crossing",
    "cycleway_link",
    "cycleway_on_highway_protected",
    "data_no",
    "separate_geometry"
  ],
  "defaults": {
    "oneway": {
      "value": "assumed_no",
      "annotate": {
        "confidence": "high"
      }
    }
  },
  "outputs": {
    "surface": "surface_from_parent",
    "traffic_mode_left": "traffic_mode_left_from_parking_both",
    "traffic_mode_right": "traffic_mode_right_from_parking_both"
  }
}
