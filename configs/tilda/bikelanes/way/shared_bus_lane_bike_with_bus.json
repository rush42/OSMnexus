{
  "condition": {
    "and": [
      {
        "not": {
          "macro": "is_crossing_pattern"
        }
      },
      {
        "key": "highway",
        "eq": "cycleway"
      },
      {
        "or": [
          {
            "key": "lane",
            "eq": "share_busway"
          },
          {
            "and": [
              {
                "key": "traffic_sign",
                "starts_with": "DE:237"
              },
              {
                "or": [
                  {
                    "key": "traffic_sign",
                    "contains": "1024-14"
                  },
                  {
                    "key": "traffic_sign",
                    "contains": "1026-32"
                  }
                ]
              }
            ]
          },
          {
            "and": [
              {
                "parent": { "key": "traffic_sign", "starts_with": "DE:237" }
              },
              {
                "or": [
                  {
                    "parent": { "key": "traffic_sign", "contains": "1024-14" }
                  },
                  {
                    "parent": { "key": "traffic_sign", "contains": "1026-32" }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "excludes": [
    "bicycle_road",
    "bicycle_road_vehicle_destination",
    "cycleway_link",
    "cycleway_on_highway_protected",
    "data_no",
    "separate_geometry"
  ],
  "defaults": {
    "oneway": {
      "value": "implicit_yes",
      "annotate": {
        "confidence": "high"
      }
    }
  },
  "producers": {
    "surface": "surface_from_parent"
  }
}
