{
  "condition": {
    "and": [
      {
        "not": {
          "macro": "is_crossing_pattern"
        }
      },
      {
        "key": "highway",
        "eq": "cycleway"
      },
      {
        "or": [
          {
            "key": "cycleway",
            "in": [
              "share_busway",
              "opposite_share_busway"
            ]
          },
          {
            "and": [
              {
                "key": "traffic_sign",
                "starts_with": "DE:245"
              },
              {
                "or": [
                  {
                    "key": "traffic_sign",
                    "contains": "1022-10"
                  },
                  {
                    "key": "traffic_sign",
                    "contains": "1022-14"
                  }
                ]
              }
            ]
          },
          {
            "and": [
              {
                "parent": { "key": "traffic_sign", "starts_with": "DE:245" }
              },
              {
                "or": [
                  {
                    "parent": { "key": "traffic_sign", "contains": "1022-10" }
                  },
                  {
                    "parent": { "key": "traffic_sign", "contains": "1022-14" }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "excludes": [
    "bicycle_road",
    "bicycle_road_vehicle_destination",
    "cycleway_link",
    "cycleway_on_highway_protected",
    "data_no",
    "separate_geometry",
    "shared_bus_lane_bike_with_bus"
  ],
  "defaults": {
    "oneway": {
      "value": "implicit_yes",
      "annotate": {
        "confidence": "high"
      }
    }
  },
  "producers": {
    "surface": "surface_from_parent"
  }
}
