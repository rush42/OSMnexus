{
  "condition": {
    "macro": "is_advisory_or_exclusive"
  },
  "excludes": [
    "bicycle_road",
    "bicycle_road_vehicle_destination",
    "crossing",
    "cycleway_adjoining",
    "cycleway_adjoining_or_isolated",
    "cycleway_isolated",
    "cycleway_link",
    "cycleway_on_highway_between_lanes",
    "data_no",
    "foot_and_cycleway_segregated_adjoining",
    "foot_and_cycleway_segregated_adjoining_or_isolated",
    "foot_and_cycleway_segregated_isolated",
    "foot_and_cycleway_shared_adjoining",
    "foot_and_cycleway_shared_adjoining_or_isolated",
    "foot_and_cycleway_shared_isolated",
    "pedestrian_area_bicycle_yes",
    "separate_geometry",
    "shared_bus_lane_bike_with_bus",
    "shared_bus_lane_bus_with_bike",
    "shared_motor_vehicle_lane"
  ],
  "defaults": {
    "oneway": {
      "value": "implicit_yes",
      "annotate": {
        "confidence": "high"
      }
    }
  },
  "producers": {
    "surface": "surface_from_parent",
    "traffic_mode_left": "traffic_mode_left_from_parking_directional",
    "traffic_mode_right": "traffic_mode_right_from_parking_directional"
  },
  "categories": [
    {
      "name": "advisory",
      "condition": {
        "tag": "lane",
        "eq": "advisory"
      }
    },
    {
      "name": "exclusive",
      "condition": {
        "tag": "lane",
        "eq": "exclusive"
      },
      "excludes": [
        "cycleway_on_highway_protected"
      ]
    },
    {
      "name": "advisory_or_exclusive",
      "excludes": [
        "cycleway_on_highway_advisory",
        "cycleway_on_highway_exclusive",
        "cycleway_on_highway_protected"
      ],
      "defaults": {
        "oneway": {
          "value": "implicit_yes",
          "annotate": {
            "confidence": "medium"
          }
        }
      }
    }
  ]
}
