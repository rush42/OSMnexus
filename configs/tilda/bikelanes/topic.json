{
  "table": "bikelanes",
  "geometry": {
    "way": ["line"]
  },
  "passthrough_tags": [
    "source:width",
    "segregated",
    "bicycle",
    "foot",
    "description",
    "note",
    "temporary",
    "separation:left",
    "separation:right",
    "separation:both",
    "marking:left",
    "marking:right",
    "marking:both",
    "traffic_mode:left",
    "traffic_mode:right",
    "traffic_mode:both",
    "buffer:left",
    "buffer:right",
    "buffer:both"
  ],
  "outputs": {
    "name": "name",
    "surface": "surface",
    "smoothness": "smoothness",
    "width": {
      "sanitizer": "parse_length"
    },
    "bridge": {
      "sanitizer": "to_bool",
      "from": "parent_or_obj"
    },
    "tunnel": {
      "sanitizer": "to_bool",
      "from": "parent_or_obj"
    },
    "oneway": "oneway",
    "oneway:bicycle": "oneway:bicycle",
    "traffic_sign": {
      "sanitizer": "traffic_sign"
    },
    "is_directed": "is_directed",
    "informal": "informal",
    "covered": "covered",
    "operator_type": "operator_type",
    "mapillary": "mapillary",
    "surface:colour": "surface:colour",
    "separation_left": {
      "sanitizer": "separation",
      "in": [
        "separation:left",
        "separation:both",
        "separation"
      ]
    },
    "separation_right": {
      "sanitizer": "separation",
      "in": [
        "separation:right",
        "separation:both"
      ]
    },
    "marking_left": {
      "sanitizer": "marking",
      "in": [
        "marking:left",
        "marking:both",
        "marking"
      ]
    },
    "marking_right": {
      "sanitizer": "marking",
      "in": [
        "marking:right",
        "marking:both"
      ]
    },
    "buffer_left": {
      "sanitizer": "buffer",
      "in": [
        "buffer:left",
        "buffer:both",
        "buffer"
      ]
    },
    "buffer_right": {
      "sanitizer": "buffer",
      "in": [
        "buffer:right",
        "buffer:both"
      ]
    },
    "surface_color": {
      "sanitizer": "surface_color",
      "in": [
        "surface:colour",
        "surface:color"
      ]
    },
    "width_effective": {
      "sanitizer": "parse_length",
      "in": "width:effective"
    },
    "lifecycle": "lifecycle",
    "traffic_mode_left": "traffic_mode_left",
    "traffic_mode_right": "traffic_mode_right",
    "road": "road"
  },
  "defaults": {
    "oneway": {
      "value": "assumed_no",
      "annotate": {
        "confidence": "not_applicable"
      }
    },
    "minzoom": 0,
    "cost": 1
  },
  "exclude_condition": {
    "macro": "standard_exclude"
  }
}
