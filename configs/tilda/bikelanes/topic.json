{
  "table": "bikelanes",
  "outputs": {
    "name": {
      "fallback": [
        {
          "key": "name"
        },
        {
          "key": "name",
          "from": "parent"
        }
      ]
    },
    "surface": "surface",
    "smoothness": "smoothness",
    "width": {
      "name": "parse_length"
    },
    "source:width": true,
    "bridge": {
      "name": "yes_flag",
      "from": "parent_or_obj"
    },
    "tunnel": {
      "name": "yes_flag",
      "from": "parent_or_obj"
    },
    "oneway": "oneway",
    "oneway:bicycle": {
      "fallback": [
        {
          "key": "oneway:bicycle"
        },
        {
          "key": "oneway:bicycle",
          "from": "parent"
        }
      ]
    },
    "traffic_sign": {
      "name": "traffic_sign"
    },
    "is_directed": {
      "rules": [
        {
          "when": {
            "tag": "oneway",
            "in": [
              "yes",
              "-1"
            ]
          },
          "value": true
        }
      ],
      "default": false
    },
    "informal": {
      "key": "informal",
      "from": "parent"
    },
    "covered": {
      "key": "covered",
      "from": "parent"
    },
    "operator_type": {
      "key": "operator_type",
      "from": "parent"
    },
    "mapillary": {
      "key": "mapillary",
      "from": "parent"
    },
    "segregated": true,
    "bicycle": true,
    "foot": true,
    "description": true,
    "note": true,
    "temporary": true,
    "separation:left": true,
    "separation:right": true,
    "separation:both": true,
    "marking:left": true,
    "marking:right": true,
    "marking:both": true,
    "traffic_mode:left": true,
    "traffic_mode:right": true,
    "traffic_mode:both": true,
    "buffer:left": true,
    "buffer:right": true,
    "buffer:both": true,
    "surface:colour": {
      "keys": [
        "surface:colour",
        "surface:color"
      ]
    },
    "separation_left": {
      "name": "separation",
      "in": [
        "separation:left",
        "separation:both",
        "separation"
      ]
    },
    "separation_right": {
      "name": "separation",
      "in": [
        "separation:right",
        "separation:both"
      ]
    },
    "marking_left": {
      "name": "marking",
      "in": [
        "marking:left",
        "marking:both",
        "marking"
      ]
    },
    "marking_right": {
      "name": "marking",
      "in": [
        "marking:right",
        "marking:both"
      ]
    },
    "buffer_left": {
      "name": "buffer",
      "in": [
        "buffer:left",
        "buffer:both",
        "buffer"
      ]
    },
    "buffer_right": {
      "name": "buffer",
      "in": [
        "buffer:right",
        "buffer:both"
      ]
    },
    "surface_color": {
      "name": "surface_color",
      "in": [
        "surface:colour",
        "surface:color"
      ]
    },
    "width_effective": {
      "name": "parse_length",
      "in": "width:effective"
    },
    "lifecycle": "lifecycle",
    "traffic_mode_left": "traffic_mode_left",
    "traffic_mode_right": "traffic_mode_right",
    "road": "road"
  },
  "consts": {
    "oneway": {
      "value": "assumed_no",
      "consts": {
        "confidence": "not_applicable"
      }
    },
    "minzoom": 0,
    "cost": 1
  },
  "exclude_condition": {
    "macro": "standard_exclude"
  },
  "input_transforms": [
    {
      "output": "highway",
      "rules": [
        {
          "when": {
            "and": [
              {
                "tag": "highway",
                "exists": true
              },
              {
                "tag": "construction",
                "in_set": "allowed_highway"
              }
            ]
          },
          "value": {
            "tag": "construction"
          }
        }
      ]
    },
    {
      "output": "lifecycle",
      "rules": [
        {
          "when": {
            "and": [
              {
                "tag": "highway",
                "exists": true
              },
              {
                "tag": "construction",
                "in_set": "allowed_highway"
              }
            ]
          },
          "value": "construction"
        },
        {
          "when": {
            "and": [
              {
                "or": [
                  {
                    "tag": "access",
                    "eq": "no"
                  },
                  {
                    "and": [
                      {
                        "tag": "highway",
                        "eq": "cycleway"
                      },
                      {
                        "tag": "bicycle",
                        "eq": "no"
                      }
                    ]
                  },
                  {
                    "and": [
                      {
                        "tag": "highway",
                        "eq": "footway"
                      },
                      {
                        "tag": "foot",
                        "eq": "no"
                      }
                    ]
                  }
                ]
              },
              {
                "or": [
                  {
                    "tag": "access:reason",
                    "contains": "construction",
                    "case_insensitive": true
                  },
                  {
                    "tag": "access:reason",
                    "contains": "baustelle",
                    "case_insensitive": true
                  },
                  {
                    "tag": "description",
                    "contains": "construction",
                    "case_insensitive": true
                  },
                  {
                    "tag": "description",
                    "contains": "baustelle",
                    "case_insensitive": true
                  },
                  {
                    "tag": "note",
                    "contains": "construction",
                    "case_insensitive": true
                  },
                  {
                    "tag": "note",
                    "contains": "baustelle",
                    "case_insensitive": true
                  }
                ]
              }
            ]
          },
          "value": "construction_no_access"
        },
        {
          "when": {
            "and": [
              {
                "or": [
                  {
                    "tag": "access",
                    "eq": "no"
                  },
                  {
                    "and": [
                      {
                        "tag": "highway",
                        "eq": "cycleway"
                      },
                      {
                        "tag": "bicycle",
                        "eq": "no"
                      }
                    ]
                  },
                  {
                    "and": [
                      {
                        "tag": "highway",
                        "eq": "footway"
                      },
                      {
                        "tag": "foot",
                        "eq": "no"
                      }
                    ]
                  }
                ]
              },
              {
                "or": [
                  {
                    "tag": "description",
                    "contains": "sperrung",
                    "case_insensitive": true
                  },
                  {
                    "tag": "description",
                    "contains": "gesperrt",
                    "case_insensitive": true
                  },
                  {
                    "tag": "description",
                    "contains": "blockiert",
                    "case_insensitive": true
                  },
                  {
                    "tag": "description",
                    "contains": "blocked",
                    "case_insensitive": true
                  },
                  {
                    "tag": "description",
                    "contains": "closure",
                    "case_insensitive": true
                  },
                  {
                    "tag": "description",
                    "contains": "closed",
                    "case_insensitive": true
                  },
                  {
                    "tag": "note",
                    "contains": "sperrung",
                    "case_insensitive": true
                  },
                  {
                    "tag": "note",
                    "contains": "gesperrt",
                    "case_insensitive": true
                  },
                  {
                    "tag": "note",
                    "contains": "blockiert",
                    "case_insensitive": true
                  },
                  {
                    "tag": "note",
                    "contains": "blocked",
                    "case_insensitive": true
                  },
                  {
                    "tag": "note",
                    "contains": "closure",
                    "case_insensitive": true
                  },
                  {
                    "tag": "note",
                    "contains": "closed",
                    "case_insensitive": true
                  }
                ]
              }
            ]
          },
          "value": "blocked"
        }
      ]
    },
    {
      "output": "construction",
      "rules": [
        {
          "when": {
            "tag": "lifecycle",
            "eq": "construction"
          },
          "value": null
        }
      ]
    },
    {
      "output": "access",
      "rules": [
        {
          "when": {
            "tag": "lifecycle",
            "in": [
              "construction_no_access",
              "blocked"
            ]
          },
          "value": null
        }
      ]
    },
    {
      "output": "bicycle",
      "rules": [
        {
          "when": {
            "and": [
              {
                "tag": "lifecycle",
                "in": [
                  "construction_no_access",
                  "blocked"
                ]
              },
              {
                "tag": "highway",
                "eq": "cycleway"
              }
            ]
          },
          "value": null
        }
      ]
    },
    {
      "output": "foot",
      "rules": [
        {
          "when": {
            "and": [
              {
                "tag": "lifecycle",
                "in": [
                  "construction_no_access",
                  "blocked"
                ]
              },
              {
                "tag": "highway",
                "eq": "footway"
              }
            ]
          },
          "value": null
        }
      ]
    },
    {
      "output": "oneway:bicycle",
      "rules": [
        {
          "when": {
            "tag": "cycleway",
            "in": [
              "opposite",
              "opposite_lane",
              "opposite_track"
            ]
          },
          "value": "no"
        }
      ]
    },
    {
      "output": "cycleway:left",
      "rules": [
        {
          "when": {
            "tag": "cycleway",
            "eq": "opposite_lane"
          },
          "value": "lane"
        },
        {
          "when": {
            "tag": "cycleway",
            "eq": "opposite_track"
          },
          "value": "track"
        }
      ]
    },
    {
      "output": "cycleway",
      "rules": [
        {
          "when": {
            "tag": "cycleway",
            "in": [
              "opposite",
              "opposite_lane",
              "opposite_track"
            ]
          },
          "value": null
        }
      ]
    },
    {
      "prefix": "construction:",
      "stamp_key": "lifecycle",
      "stamp_value": "construction",
      "stamp_nested_under": [
        "cycleway:",
        "sidewalk:"
      ]
    },
    {
      "output": "cycleway:both",
      "rules": [
        {
          "when": {
            "tag": "cycleway",
            "eq": "no"
          },
          "value": {
            "tag": "cycleway"
          }
        }
      ]
    },
    {
      "output": "cycleway",
      "rules": [
        {
          "when": {
            "tag": "cycleway",
            "eq": "no"
          },
          "value": null
        }
      ]
    },
    {
      "prefix": "cycleway"
    },
    {
      "output": "traffic_sign",
      "rules": [
        {
          "when": {
            "and": [
              {
                "tag": "highway",
                "in_set": "sidepath_highway"
              },
              {
                "tag": "traffic_sign",
                "exists": false
              },
              {
                "tag": "oneway",
                "eq": "yes"
              },
              {
                "not": {
                  "tag": "oneway:bicycle",
                  "eq": "no"
                }
              }
            ]
          },
          "value": {
            "tag_or": "traffic_sign:forward",
            "or": ""
          }
        }
      ]
    }
  ],
  "split_sides": [
    {
      "highway": "cycleway",
      "prefix": "cycleway",
      "directed_keys": [
        "cycleway:lanes",
        "bicycle:lanes"
      ],
      "self_directed_keys": [
        "traffic_sign"
      ]
    },
    {
      "highway": "footway",
      "prefix": "sidewalk",
      "self_directed_keys": [
        "traffic_sign"
      ]
    }
  ]
}
