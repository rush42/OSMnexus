{
  "is_construction_highway": {
    "and": [
      { "tag": "highway", "exists": true },
      { "tag": "construction", "in_set": "allowed_highway" }
    ]
  },
  "is_allowed_highway": {
    "or": [
      { "macro": "is_construction_highway" },
      { "tag": "highway", "in_set": "allowed_highway" }
    ]
  },
  "standard_exclude": {
    "or": [
      { "not": { "macro": "is_allowed_highway" } },
      { "tag": "area",     "eq": "yes" },
      { "tag": "man_made", "eq": "pier" },
      { "tag": "leisure",  "eq": "track" },
      { "tag": "indoor",   "eq": "yes" }
    ]
  }
}
