{
  "table": "walk",
  "outputs": {
    "highway": true,
    "name": true,
    "ref": true,
    "footway": true,
    "access": true,
    "foot": true,
    "service": true,
    "area": true,
    "landuse": true,
    "bridge": true,
    "tunnel": true
  },
  "exclude_condition": {
    "or": [
      {
        "tag": "highway",
        "exists": false
      },
      {
        "tag": "area",
        "eq": "yes"
      },
      {
        "tag": "access",
        "eq": "private"
      },
      {
        "tag": "foot",
        "eq": "no"
      },
      {
        "tag": "service",
        "eq": "private"
      },
      {
        "tag": "sidewalk",
        "eq": "separate"
      },
      {
        "tag": "sidewalk:both",
        "eq": "separate"
      },
      {
        "tag": "sidewalk:left",
        "eq": "separate"
      },
      {
        "tag": "sidewalk:right",
        "eq": "separate"
      },
      {
        "tag": "highway",
        "contains": "motor"
      },
      {
        "tag": "highway",
        "in": [
          "abandoned",
          "bus_guideway",
          "construction",
          "cycleway",
          "no",
          "planned",
          "platform",
          "proposed",
          "raceway",
          "razed",
          "rest_area",
          "services"
        ]
      }
    ]
  }
}
