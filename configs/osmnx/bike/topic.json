{
  "table": "bike",
  "geometry": {
    "way": ["line"]
  },
  "outputs": {
    "highway": true,
    "name": true,
    "ref": true,
    "access": true,
    "bicycle": true,
    "service": true,
    "area": true,
    "landuse": true,
    "bridge": true,
    "tunnel": true
  },
  "exclude_condition": {
    "or": [
      {
        "tag": "highway",
        "exists": false
      },
      {
        "tag": "area",
        "eq": "yes"
      },
      {
        "tag": "access",
        "eq": "private"
      },
      {
        "tag": "bicycle",
        "eq": "no"
      },
      {
        "tag": "service",
        "eq": "private"
      },
      {
        "tag": "highway",
        "contains": "motor"
      },
      {
        "tag": "highway",
        "in": [
          "abandoned",
          "bus_guideway",
          "construction",
          "corridor",
          "elevator",
          "escalator",
          "footway",
          "no",
          "planned",
          "platform",
          "proposed",
          "raceway",
          "razed",
          "rest_area",
          "services",
          "steps"
        ]
      }
    ]
  }
}
