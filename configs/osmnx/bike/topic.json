{
  "table": "bike",
  "geometry": {
    "way": ["line"]
  },
  "passthrough_tags": [
    "highway",
    "name",
    "ref",
    "access",
    "bicycle",
    "service",
    "area",
    "landuse",
    "bridge",
    "tunnel"
  ],
  "exclude_condition": {
    "or": [
      {
        "tag": "highway",
        "exists": false
      },
      {
        "tag": "area",
        "eq": "yes"
      },
      {
        "tag": "access",
        "eq": "private"
      },
      {
        "tag": "bicycle",
        "eq": "no"
      },
      {
        "tag": "service",
        "eq": "private"
      },
      {
        "tag": "highway",
        "contains": "motor"
      },
      {
        "tag": "highway",
        "in": [
          "abandoned",
          "bus_guideway",
          "construction",
          "corridor",
          "elevator",
          "escalator",
          "footway",
          "no",
          "planned",
          "platform",
          "proposed",
          "raceway",
          "razed",
          "rest_area",
          "services",
          "steps"
        ]
      }
    ]
  }
}
