{
  "table": "drive",
  "geometry": {
    "way": ["line"]
  },
  "outputs": {
    "highway": true,
    "name": true,
    "ref": true,
    "maxspeed": true,
    "oneway": true,
    "lanes": true,
    "junction": true,
    "access": true,
    "service": true,
    "area": true,
    "landuse": true,
    "est_width": true,
    "width": true,
    "bridge": true,
    "tunnel": true
  },
  "exclude_condition": {
    "or": [
      {
        "tag": "highway",
        "exists": false
      },
      {
        "tag": "area",
        "eq": "yes"
      },
      {
        "tag": "access",
        "eq": "private"
      },
      {
        "tag": "motor_vehicle",
        "eq": "no"
      },
      {
        "tag": "motorcar",
        "eq": "no"
      },
      {
        "tag": "highway",
        "in": [
          "abandoned",
          "bridleway",
          "bus_guideway",
          "construction",
          "corridor",
          "cycleway",
          "elevator",
          "escalator",
          "footway",
          "no",
          "path",
          "pedestrian",
          "planned",
          "platform",
          "proposed",
          "raceway",
          "razed",
          "rest_area",
          "service",
          "services",
          "steps",
          "track"
        ]
      },
      {
        "tag": "service",
        "in": [
          "alley",
          "driveway",
          "emergency_access",
          "parking",
          "parking_aisle",
          "private"
        ]
      }
    ]
  }
}
