{
  "table": "drive",
  "accept_all": { "way": true },
  "geometry_output": {
    "way": "line"
  },
  "passthrough_tags": [
    "highway",
    "name",
    "ref",
    "maxspeed",
    "oneway",
    "lanes",
    "junction",
    "access",
    "service",
    "area",
    "landuse",
    "est_width",
    "width",
    "bridge",
    "tunnel"
  ],
  "exclude_condition": {
    "or": [
      {
        "key": "highway",
        "exists": false
      },
      {
        "key": "area",
        "eq": "yes"
      },
      {
        "key": "access",
        "eq": "private"
      },
      {
        "key": "motor_vehicle",
        "eq": "no"
      },
      {
        "key": "motorcar",
        "eq": "no"
      },
      {
        "key": "highway",
        "in": [
          "abandoned",
          "bridleway",
          "bus_guideway",
          "construction",
          "corridor",
          "cycleway",
          "elevator",
          "escalator",
          "footway",
          "no",
          "path",
          "pedestrian",
          "planned",
          "platform",
          "proposed",
          "raceway",
          "razed",
          "rest_area",
          "service",
          "services",
          "steps",
          "track"
        ]
      },
      {
        "key": "service",
        "in": [
          "alley",
          "driveway",
          "emergency_access",
          "parking",
          "parking_aisle",
          "private"
        ]
      }
    ]
  }
}
